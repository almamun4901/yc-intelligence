{
  "name": "yc-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "turbo build --cache-dir .turbo/cache",
    "dev": "turbo dev --cache-dir .turbo/cache",
    "test": "turbo test --cache-dir .turbo/cache",
    "lint": "turbo lint --cache-dir .turbo/cache",
    "typecheck": "turbo typecheck --cache-dir .turbo/cache",
    "format": "prettier --write ."
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "typescript-eslint": "^8.48.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
