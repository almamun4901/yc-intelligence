generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model MemoryEntry {
  id             String   @id @default(uuid())
  type           String
  title          String
  body           String
  tags           String[]
  status         String   @default("active")
  confidence     Float    @default(1.0)
  supersedesId   String?
  supersededById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sources MemorySource[]

  @@index([type])
  @@index([status])
  @@index([tags], type: Gin)
  @@index([supersedesId])
  @@index([supersededById])
  @@map("memory_entries")
}

model MemorySource {
  id            String   @id @default(uuid())
  memoryEntryId String
  sourceType    String
  sourceRef     String
  sourceTitle   String?
  /// Attribution context only; do not store reproduced external content.
  sourceExcerpt String?  @db.VarChar(500)
  createdAt     DateTime @default(now())

  memoryEntry MemoryEntry @relation(fields: [memoryEntryId], references: [id], onDelete: Cascade)

  @@index([memoryEntryId])
  @@index([sourceType])
  @@map("memory_sources")
}

model Company {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  batch            String?
  status           String   @default("Active")
  description      String?
  shortDescription String?
  website          String?
  teamSize         String?
  isHiring         Boolean  @default(false)
  tags             String[]
  location         String?
  rawData          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  founders Founder[]

  @@index([slug])
  @@index([batch])
  @@index([status])
  @@index([isHiring])
  @@index([tags], type: Gin)
  @@map("companies")
}

model Founder {
  id                String   @id @default(uuid())
  companyId         String
  name              String
  linkedinUrl       String?
  previousEmployers String[]
  schools           String[]
  createdAt         DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("founders")
}

model RefreshLog {
  id          String    @id @default(uuid())
  source      String
  startedAt   DateTime
  completedAt DateTime?
  recordCount Int       @default(0)
  errorCount  Int       @default(0)
  status      String
  errorMsg    String?

  @@index([source])
  @@index([status])
  @@index([startedAt])
  @@map("refresh_logs")
}
