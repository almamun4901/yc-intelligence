{
  "name": "@yc-intelligence/core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "pipeline:companies": "node dist/pipeline/cli.js companies",
    "pipeline:embeddings": "node dist/pipeline/cli.js embeddings",
    "pipeline:founders": "node dist/pipeline/cli.js founders",
    "pipeline:hn": "node dist/pipeline/cli.js hn",
    "pipeline:jobs": "node dist/pipeline/cli.js jobs",
    "pipeline:refresh": "node dist/pipeline/cli.js refresh",
    "pipeline:schedule": "node dist/pipeline/cli.js schedule",
    "pipeline:seed": "node dist/pipeline/cli.js seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "smoke:semantic": "node dist/pipeline/semanticSmoke.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "prisma": "^6.8.2"
  }
}
